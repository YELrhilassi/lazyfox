{
  "name": "lazyfox",
  "version": "0.5.7",
  "private": true,
  "description": "Keyboard-first, UI-free Firefox. Leader-key navigation, paginated which-key overlay, centered search, tab switcher and link hints.",
  "type": "module",
  "scripts": {
    "build": "node build.ts --dev",
    "sync": "node scripts/sync.ts",
    "sync:verify": "node scripts/sync.ts --verify",
    "test:wire": "node scripts/test-relay-wire.ts",
    "test:store": "node scripts/test-store.ts",
    "test:escaping": "node --experimental-strip-types scripts/test-render-escaping.ts",
    "check": "node scripts/check-installer-payload.ts",
    "check:fix": "node scripts/check-installer-payload.ts --fix",
    "gen:icons": "node scripts/gen-icons.ts",
    "ship": "node scripts/ship.ts",
    "ship:nightly": "node scripts/ship-nightly.ts",
    "bump": "node scripts/bump-version.ts",
    "submit": "node scripts/submit.ts",
    "listing": "node scripts/amo-listing.ts",
    "screenshots": "node scripts/amo-screenshots.ts",
    "build:installers": "node scripts/build-dev-installers.ts",
    "build:release-installers": "node scripts/build-release-installers.ts",
    "ui:build": "npm --prefix installer/frontend run build",
    "ui:dev": "npm --prefix installer/frontend run dev",
    "build:release": "RELEASE=1 node build.ts",
    "installer": "node scripts/open-installer.ts",
    "dev-install": "node scripts/dev-install.ts",
    "dev-install:clean": "node scripts/dev-install.ts --clean",
    "clean": "node scripts/clean.ts",
    "clean:all": "node scripts/clean.ts --all",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit && npm --prefix installer/frontend run typecheck",
    "test": "go test ./core/ && node scripts/test-history-related.ts && node scripts/test-dev-helpers.ts && node scripts/test-keyguard.ts && node scripts/test-chrome-keys.ts && node scripts/test-relay-wire.ts && node scripts/test-store.ts && node --experimental-strip-types scripts/test-render-escaping.ts && node scripts/test-page-text.ts && node scripts/test-find-text.ts && node scripts/test-payload.ts && node scripts/test-installer.ts && node scripts/check-dist.ts && node scripts/check-installer-payload.ts",
    "ci": "node scripts/ci.ts",
    "ci:bidi": "node scripts/ci.ts --bidi",
    "ci:hints": "node scripts/ci.ts --hints",
    "bidi": "node scripts/bidi/test.ts",
    "bidi:hints": "node scripts/bidi/test.ts --suite content --only \"link hints:\"",
    "probe:chrome": "node scripts/bidi/chrome-probe.ts",
    "verify": "npm run typecheck && npm test",
    "prepare": "node scripts/check-toolchain.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}

{
  "name": "lazyfox",
  "version": "0.5.5",
  "private": true,
  "description": "Keyboard-first, UI-free Firefox. Leader-key navigation, paginated which-key overlay, centered search, tab switcher and link hints.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs --dev",
    "build:release": "RELEASE=1 node build.mjs",
    "submit": "node scripts/submit.mjs",
    "build:installers": "node scripts/build-dev-installers.mjs",
  "dev-install": "node scripts/dev-install.mjs",
  "dev-install:clean": "node scripts/dev-install.mjs --clean",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "test": "go test ./core/ && node scripts/test-installer.mjs && node scripts/check-dist.mjs",
  "ci": "node scripts/ci.mjs",
  "ci:bidi": "node scripts/ci.mjs --bidi",
  "bidi": "node scripts/bidi/test.mjs",
  "probe:chrome": "node scripts/bidi/chrome-probe.mjs",
  "verify": "npm run typecheck && npm test",
    "prepare": "node scripts/check-toolchain.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
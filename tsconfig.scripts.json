{
  // Typecheck for the Node-side build/release tooling (build.ts + scripts/).
  // These run directly under Node 24's native type-stripping — no emit, no
  // bundling — so this config only exists to typecheck them. Kept separate
  // from tsconfig.json because the src/ tree targets the browser/DOM and
  // deliberately declares no ambient Node types.
  //
  // scripts/e2e/ is a test harness that talks to the raw (untyped) WebDriver
  // BiDi protocol, so it is excluded here: its values are protocol messages,
  // and forcing types on them would be a lie.
  //
  // scripts/test-page-text.ts is excluded for the opposite reason: it unit-tests
  // a DOM module (the page-text walk), so it needs the DOM lib this config
  // deliberately omits. The module itself is still typechecked — by
  // tsconfig.json, which is the config that owns the browser tree.
  //
  // scripts/test-store.ts is excluded for a near-identical reason: it unit-tests
  // a browser module (the storage schema), and store.ts reaches the `browser`
  // global, which is declared ambiently in src/shared/globals.d.ts. That file
  // is browser-chrome-only and drags in Firefox chrome globals this config
  // knows nothing about. The store is still typechecked by tsconfig.json; only
  // the Node-side TEST of it is out of scope here, exactly as with page-text.
  // scripts/test-render-escaping.ts is excluded for the same reason: it calls
  // the real row renderers, which live in DOM modules, and their typechecking
  // belongs to tsconfig.json. The renderers are still checked there; only the
  // Node-side test of them is out of scope for this config.
  //
  // scripts/test-find-text.ts is the fourth of these: it tests find/text.ts,
  // whose segment tables are typed as DOM Text nodes. Note that excluding the
  // test also stops this config reaching find/text.ts at all, because nothing
  // else here imports it — which is the intent. find/text.ts is typechecked by
  // tsconfig.json, like every module in the browser tree.
  //
  // scripts/test-chrome-keys.ts is the fifth: it tests chrome/keys.ts, the
  // synthetic #lfc=keys channel, which reaches Firefox chrome globals
  // (Services, window, Cu) that only src/chrome's ambient declarations name.
  // The module and the test's DOM-free parts are still typechecked by
  // tsconfig.json; only the Node-side test of it is out of scope here.
  //
  // scripts/test-overlays.ts is the sixth: it tests favicon.ts and
  // manualtext.ts, whose signatures speak in DOM types (KeyboardEvent,
  // HTMLInputElement) this DOM-less config cannot name. The modules are still
  // typechecked by tsconfig.json.
  //
  // scripts/test-leader-sequences.ts is the seventh, for the same reason: it
  // drives LeaderController.handleKey with synthetic KeyboardEvent-shaped
  // objects, and leader.ts's public surface is typed against the DOM.
  //
  // scripts/test/keyhold.test.ts is excluded for the reason the older files
  // were: it drives chrome/keysdispatch.ts, whose deps and key shapes are
  // typed against the DOM and Firefox chrome globals this config knows nothing
  // about. The module is typechecked by tsconfig.json; only the Node-side test
  // of it is out of scope here.
  //
  // scripts/test/chrome-state.test.ts and scripts/test/wire-replay.test.ts are
  // the eighth and ninth, for the same reason and by the same mechanism: both
  // drive the REAL createDebug().handle() (the first to prove a reply the
  // product writes round-trips through the decoder the harness reads with; the
  // second to replay the committed traces through it), and debug.ts imports
  // chrome/config.ts, which still reads `Services` directly — it is one of the
  // declared backlog modules in src/chrome/dependency-audit.ts, not yet on the
  // env seam. So importing debug.ts from a Node-side test drags Firefox chrome
  // globals into a DOM-less config.
  //
  // scripts/test/relay-queue.test.ts is the tenth, and for the same reason as
  // test-store.ts: it drives extension/services/relay.ts, which reaches the
  // `browser` global (and so does the port bookkeeping under test). The module
  // is typechecked by tsconfig.json; only the Node-side test of it is out of
  // scope here.
  //
  // scripts/test/typing-target.test.ts is the eleventh, and for the same
// reason: it drives shared/dom.ts — the typing-target predicate — with
// synthetic event/element objects. dom.ts is DOM-typed top to bottom
// (Element, ShadowRoot, composedPath), so the test cannot live in a DOM-less
// config. The module itself is typechecked by tsconfig.json, which owns the
// browser tree.
//
// scripts/test/keymap.test.ts is the twelfth. It is the DRIFT CHECK between
// the Go keymap (core/keymap.go) and the TypeScript action tables, so it has
// to be able to see the action tables — popups/leader.ts and the three host
// tables — and those are DOM-typed because they are what builds the popups.
// The keymap module it checks (shared/keymap.ts) is DOM-free and typechecked
// by tsconfig.json; only this Node-side harness is out of scope here.
//
// Worth being precise about what is and is not checked here. src/chrome/
  // env.ts and src/chrome/stateapi.ts — the two modules these tests exist to
  // cover — are DOM-free and DO typecheck cleanly under this config, which is
  // deliberate: the state contract has to be readable from Node or the whole
  // seam is theatre. Only the debug.ts import forces the exclusion, and when
  // config.ts is converted to the seam these two come straight back in.
  //
  // The Node-side tests themselves now live in scripts/test/*.test.ts and run
  // under node:test. They are INCLUDED here (see the include list below), so a
  // change to a test file cannot silently break the build — scripts/test/ is
  // one level below the old "scripts/*.ts" pattern and was, briefly, in no
  // typecheck at all, exactly like the e2e harness was.
  "exclude": [
    "scripts/test-page-text.ts",
    "scripts/test-store.ts",
    "scripts/test-render-escaping.ts",
    "scripts/test-find-text.ts",
    "scripts/test-chrome-keys.ts",
    "scripts/test-overlays.ts",
    "scripts/test-leader-sequences.ts",
    "scripts/test/keyhold.test.ts",
    "scripts/test/chrome-state.test.ts",
    "scripts/test/wire-replay.test.ts",
    "scripts/test/relay-queue.test.ts",
    "scripts/test/typing-target.test.ts",
    "scripts/test/keymap.test.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["build.ts", "scripts/*.ts", "scripts/test/**/*.ts"]
}

node_modules/
web-ext-artifacts/
# The installer window's front-end build output. It is `go:embed`-ed, but
# scripts/installer-build.ts always runs ensureFrontend() (which npm-installs
# and rebuilds it) before any Go compile, so committing it would only add
# churn and stale hashed bundles.
installer/frontend/dist/
dist/extension/*.xpi
# Per-platform build output (the current-platform native host, wasm staging, …).
# Regenerated by every `npm run build`; never source. A stray copy was committed
# once and then shadowed builds on other platforms.
build/

# Local secrets (AMO signing credentials etc.). See .env.example. Never commit.
.env
.env.*
!.env.example
# Host-specific installer built by `npm run build:installer` (the committed,
# distributable binaries are the per-OS ones in installer/bin/).
installer/bin/lazyfox-install
.tools/
.freebuff/
Thumbs.db
.DS_Store
*.log
core/js/core.wasm
src/shared/wasm-embed.ts
# Real-world page snapshots for the hint stress test (downloaded on demand by
# scripts/bidi/fetch-fixtures.ts; not source, never committed).
scripts/bidi/fixtures/
# Content stamps beside the dev installer binaries: written by the build, used to
# detect a stale installer by CONTENT (not mtime). Regenerated every build.
installer/bin/*.stamp
